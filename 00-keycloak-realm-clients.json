{
  "_comment": [
    "Step 0 (in the external Keycloak, before anything else). Partial import: Realm settings -> Action -> Partial import, or kcadm.",
    "Replace ${...} by hand or with envsubst (see vars.env.example). Client secrets: let Keycloak generate them, then create the OpenShift Secrets named in 04 and 05.",
    "Shape is what worked on a test realm (OpenShift 4.22, RHOAI 3.5.2, 2026-11).",
    "groups mapper: full.path=false so the claim is 'maas-users', not '/maas-users'.",
    "argocd: no PKCE requirement - Argo CD's server-side flow sends no code_challenge_method, so setting one fails every sign-in. Its groups claim comes from the groups client scope, which Argo CD requests by name; a realm without that scope rejects the sign-in.",
    "Audience mappers: the API server (04) accepts tokens whose aud contains a listed client; OGX (10) checks KEYCLOAK_OGX_AUDIENCE.",
    "Token lifespan: 5 minutes is fine, but the RHOAI gateway cookie.refresh must be lower (05).",
    "Agent acting for a user: Keycloak standard token exchange (RFC 8693) on the agent's client. Not shown; no Red Hat-documented pattern with ZTWIM yet (RHAISTRAT-2932). If you enable it, use RHBK 26.6.z; long exchange chains fail on older builds (RHBK-3492)."
  ],
  "clients": [
    {
      "clientId": "${KEYCLOAK_CONSOLE_CLIENT}",
      "publicClient": false,
      "standardFlowEnabled": true,
      "redirectUris": ["https://${CONSOLE_HOST}/auth/callback"],
      "attributes": {"pkce.code.challenge.method": "S256"},
      "protocolMappers": [
        {"name": "groups", "protocol": "openid-connect", "protocolMapper": "oidc-group-membership-mapper",
         "config": {"claim.name": "groups", "full.path": "false", "id.token.claim": "true", "access.token.claim": "true", "userinfo.token.claim": "true"}},
        {"name": "aud-cli", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper",
         "config": {"included.client.audience": "${KEYCLOAK_CLI_CLIENT}", "id.token.claim": "false", "access.token.claim": "true"}}
      ]
    },
    {
      "clientId": "${KEYCLOAK_CLI_CLIENT}",
      "publicClient": true,
      "standardFlowEnabled": true,
      "redirectUris": ["http://localhost:8080", "http://localhost:8080/*", "http://localhost:8090", "http://localhost:8090/*"],
      "attributes": {"pkce.code.challenge.method": "S256"},
      "protocolMappers": [
        {"name": "groups", "protocol": "openid-connect", "protocolMapper": "oidc-group-membership-mapper",
         "config": {"claim.name": "groups", "full.path": "false", "id.token.claim": "true", "access.token.claim": "true", "userinfo.token.claim": "true"}},
        {"name": "aud-ogx", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper",
         "config": {"included.custom.audience": "${KEYCLOAK_OGX_AUDIENCE}", "id.token.claim": "false", "access.token.claim": "true"}}
      ]
    },
    {
      "clientId": "${KEYCLOAK_GATEWAY_CLIENT}",
      "publicClient": false,
      "standardFlowEnabled": true,
      "redirectUris": ["https://${RHOAI_GATEWAY_HOST}/oauth2/callback"],
      "protocolMappers": [
        {"name": "groups", "protocol": "openid-connect", "protocolMapper": "oidc-group-membership-mapper",
         "config": {"claim.name": "groups", "full.path": "false", "id.token.claim": "true", "access.token.claim": "true", "userinfo.token.claim": "true"}},
        {"name": "aud-self", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper",
         "config": {"included.client.audience": "${KEYCLOAK_GATEWAY_CLIENT}", "id.token.claim": "false", "access.token.claim": "true"}}
      ]
    },
    {
      "clientId": "${KEYCLOAK_ARGOCD_CLIENT}",
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["https://${ARGOCD_HOST}/auth/callback", "http://localhost:8085/auth/callback"],
      "webOrigins": ["https://${ARGOCD_HOST}"],
      "defaultClientScopes": ["profile", "email", "roles", "web-origins", "groups"],
      "protocolMappers": [
        {"name": "aud-self", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper",
         "config": {"included.client.audience": "${KEYCLOAK_ARGOCD_CLIENT}", "id.token.claim": "false", "access.token.claim": "true"}}
      ]
    }
  ],
  "clientScopes": [
    {
      "name": "groups",
      "protocol": "openid-connect",
      "attributes": {"include.in.token.scope": "true"},
      "protocolMappers": [
        {"name": "groups", "protocol": "openid-connect", "protocolMapper": "oidc-group-membership-mapper",
         "config": {"claim.name": "groups", "full.path": "false", "id.token.claim": "true", "access.token.claim": "true", "userinfo.token.claim": "true"}}
      ]
    }
  ],
  "groups": [{"name": "maas-users"}]
}
