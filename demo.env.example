# Copy to demo.env (not committed) and list the demo agents in call order.
# Each entry: namespace/serviceaccount[=Display Name]. Use quotes; separate entries with spaces;
# display names must not contain spaces (use Research-Agent, not "Research Agent").
DEMO_USER=alice
DEMO_AGENTS="agents/planner=Planner agents/researcher=Researcher tools/mcp-client=MCP-Client"
# Optional:
# IMAGE=registry.example.com/demo/otel-spiffe-python:1   # image with the Python libs preinstalled (disconnected)
# OTLP_ENDPOINT=http://otel-collector.tracing.svc.cluster.local:4318
