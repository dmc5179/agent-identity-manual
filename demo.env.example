# Copy to demo.env (not committed) and list the demo agents in call order.
# Each entry: namespace/serviceaccount[=Display Name]. Use quotes; separate entries with spaces;
# display names must not contain spaces (use Research-Agent, not "Research Agent").
DEMO_USER=alice
DEMO_AGENTS="agents/planner=Planner agents/researcher=Researcher tools/mcp-client=MCP-Client"
# Optional:
# IMAGE=registry.example.com/demo/otel-spiffe-python:1   # image with the Python libs preinstalled (disconnected)
# OTLP_ENDPOINT=http://otel-collector.tracing.svc.cluster.local:4318
# Scales the staged timing of each agent's steps (1.0 = about 3-5 s per agent).
#DEMO_PACE=1.0
# Optional: the last agent makes one real MCP tool call through the MCP gateway, as its own
# service account. Unset = no MCP step. "$NS" in the arguments becomes the agent's namespace.
#DEMO_MCP_TOOL=openshift_pods_list_in_namespace
#DEMO_MCP_ARGS='{"namespace":"$NS"}'   # single quotes: this file is sourced by bash
# Defaults: the in-cluster gateway Service, and Host mcp.<apps domain>.
#DEMO_MCP_URL=http://mcp-gateway-openshift-default.openshift-ingress.svc.cluster.local:8080/mcp
#DEMO_MCP_HOST=mcp.apps.example.com
