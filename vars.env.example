# Copy to vars.env, fill in, then render each file with:
#   set -a; . ./vars.env; set +a
#   envsubst "$(sed -n 's/^\([A-Z_]*\)=.*/${\1}/p' vars.env | tr '\n' ' ')" < FILE.yaml | oc apply -f -
# Only the variables listed here are substituted; other ${...} text is left alone.

# --- Cluster ---
APPS_DOMAIN=apps.example.com              # oc get ingresses.config.openshift.io cluster -o jsonpath='{.spec.domain}'
CONSOLE_HOST=console-openshift-console.apps.example.com
RHOAI_GATEWAY_HOST=rh-ai.apps.example.com # oc get route data-science-gateway -n openshift-ingress

# --- Keycloak (outside the cluster) ---
KEYCLOAK_ISSUER=https://keycloak.example.com/realms/agents   # must equal the token "iss" exactly
KEYCLOAK_CLI_CLIENT=oc-cli                # public client, redirect http://localhost:8080
KEYCLOAK_CONSOLE_CLIENT=openshift-console # confidential, redirect https://${CONSOLE_HOST}/auth/callback
KEYCLOAK_GATEWAY_CLIENT=rhoai-gateway     # confidential, redirect https://${RHOAI_GATEWAY_HOST}/oauth2/callback
KEYCLOAK_OGX_AUDIENCE=ogx-api             # audience OGX checks (an audience mapper in Keycloak)

# --- SPIFFE / SPIRE ---
TRUST_DOMAIN=example.com                  # an identity string, not DNS. Effectively immutable once set.
CLUSTER_NAME=prod-cluster-1               # stamped into agent SPIFFE IDs
SPIRE_JWT_ISSUER=https://spire-oidc.apps.example.com   # host must be under *.APPS_DOMAIN

# --- Agents, OGX, tracing ---
AGENT_NAMESPACE=agents                    # where your agents run
OGX_NAMESPACE=agents                      # where the OGXServer runs
TRACING_NAMESPACE=tracing                 # Tempo + OpenTelemetry collector
